{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@container/*": ["src/container/*"],
      "@context/*": ["src/context/*"],
      "@html/*": ["src/html/*"],
      "@navigation/*": ["src/navigation/*"],
      "@network/*": ["src/network/*"],
      "@screens/*": ["src/screens/*"],
      "@service/*": ["src/service/*"],
      "@translations/*": ["src/translations/*"],
      "@utils/*": ["src/utils/*"],
    }
  }
}
